# ===== General =====
DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1,midominio.com,www.midominio.com,api.midominio.com,whatsapp.midominio.com,status.midominio.com,flower.midominio.com,traefik.midominio.com
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com,https://api.midominio.com

# ===== Dominio / Traefik =====
DOMAIN=midominio.com
ACME_EMAIL=admin@midominio.com
# Usuario:contraseña hasheado con: htpasswd -nbB admin TU_PASSWORD
TRAEFIK_BASICAUTH=admin:$$2y$$05$$hash
FLOWER_BASICAUTH=admin:$$2y$$05$$hash

# ===== Base de datos =====
POSTGRES_DB=agenda
POSTGRES_USER=agenda_app
POSTGRES_PASSWORD=change-me
# Django se conecta a través de PgBouncer (pooling en modo transaction)
DATABASE_URL=postgres://agenda_app:change-me@pgbouncer:5432/agenda

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== WhatsApp Cloud API =====
WHATSAPP_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_API_VERSION=v21.0

# ===== Seguridad JWT (API) =====
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ===== Backups =====
BACKUP_GPG_RECIPIENT=admin@midominio.com
RCLONE_REMOTE=backblaze-b2:agenda-backups
BACKUP_RETENTION_DAYS=7
