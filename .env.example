# ===== Dominio / TLS =====
DOMAIN=agenda.example.com
ACME_EMAIL=admin@example.com

# ===== Entorno general =====
NODE_ENV=development

# ===== Base de datos =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenda
POSTGRES_USER=agenda_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://agenda_app:change-me@localhost:5432/agenda?schema=public

# PgBouncer (modo transaction, puerto 6432)
PGBOUNCER_URL=postgres://agenda_app:change-me@localhost:6432/agenda?schema=public

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===== Auth / JWT =====
# Usar un secreto de al menos 32 caracteres en producción.
JWT_SECRET=change-me-change-me-change-me-123
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ===== Web =====
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== WhatsApp (Meta Cloud API) =====
WHATSAPP_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_API_VERSION=v20.0

# ===== Backup / almacenamiento externo =====
BACKUP_GPG_RECIPIENT=admin@example.com
RCLONE_REMOTE=backblaze-b2:agenda-backups
